DATABASE_URL=sqlite:///./sightpay.db
PUBLIC_BASE_URL=http://localhost:8000   # demo: http://<LAN-IP>:8000 so phones can load photo_url
VISION_PROVIDER=fixture            # set to "claude" for live AI
# Required when VISION_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Leave N8N_WEBHOOK_URL empty to run the pipeline inline; for n8n: http://localhost:5678/webhook/sightpay-visit
# (keep comments on their own line: after an empty value, python-dotenv would read the comment as the value)
N8N_WEBHOOK_URL=
INTERNAL_TOKEN=dev-internal-token
GPS_RADIUS_M=100                   # demo: 200 (indoor GPS drift)
WHATSAPP_MODE=dry_run
MEMORY_BACKEND=sql
# Leave SARVAM_API_KEY empty to use the Hindi/Marathi templates without audio
SARVAM_API_KEY=
# Leave the Twilio credentials empty to keep WhatsApp in dry_run
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
# Demo: set to a team phone so no WhatsApp ever reaches a real merchant
WHATSAPP_DEMO_TO=
COGNEE_TIMEOUT_S=8
